<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fallback for devices without root: the panel can write its JSON to a
         public folder. The reliable path is still a root copy into
         com.miui.home's own files directory, which needs no permission.
         ScopedStorage is a Play-policy warning; this LSPosed module is
         sideloaded and needs the fallback for unrooted devices. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 11+ package visibility: needed to read com.miui.home's UID for
         the root chown and to show its install state in the panel. -->
    <queries>
        <package android:name="com.miui.home" />
    </queries>

    <!--
        Modern (API 101+) module contract:

          * META-INF/xposed/java_init.list   - entry class(es), lives in src/main/resources
          * META-INF/xposed/native_init.list - .so file name(s) whose native_init to call
          * META-INF/xposed/module.prop      - minApiVersion / targetApiVersion / staticScope
          * META-INF/xposed/scope.list       - com.miui.home

        There must be NO xposedminversion / xposedscope meta-data here: those are
        the legacy markers, and a legacy module is expected to ship
        assets/xposed_init instead. Vector picks the loading strategy from
        module.prop (targetApiVersion >= 101 => modern) and would otherwise load
        this APK through the legacy path, which has no entry class to find.

        android:description is what the module list shows for a modern module;
        the legacy xposeddescription value is ignored.

        android:extractNativeLibs is NOT written here: AGP 9 derives it from
        packaging.jniLibs.useLegacyPackaging = false (it warns if the attribute
        is also present in the source manifest), and the merged manifest still
        ends up with extractNativeLibs="false".
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiuiHomeEdit">



        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MiuiHomeEdit"
            tools:ignore="RedundantLabel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Lets the Vector/LSPosed module manager open this panel. -->
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>
    </application>

</manifest>